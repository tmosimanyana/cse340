# Copy this file to .env and replace the placeholders.
# Never commit .env or place real credentials in this file.

PORT=5500
NODE_ENV=development

# PostgreSQL connection string, for example:
# postgres://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME
DATABASE_URL=postgres://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME

# Use a long, random, unique value for local development.
SESSION_SECRET=replace_with_a_long_random_secret
