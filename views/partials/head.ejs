<head>
  <!-- Character encoding for proper text rendering -->
  <meta charset="UTF-8">
  
  <!-- Specifies compatibility with older versions of Internet Explorer -->
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  
  <!-- Ensures responsiveness for mobile and tablet devices -->
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <!-- Dynamic title based on the title variable passed to EJS -->
  <title><%= title %> | CSE 340 App</title>
  
  <!-- Link to the CSS stylesheet -->
  <link rel="stylesheet" href="/css/styles.css" media="screen">
  
  <!-- Optionally, add any favicons or external fonts -->
  <link rel="icon" href="/images/favicon.ico" type="image/x-icon">
  <!-- For example, if you're using Google Fonts -->
  <!-- <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet"> -->
  
  <!-- Include any additional meta tags for SEO, social media, etc. -->
  <meta name="description" content="CSE 340 Application, Inventory Management System">
  <meta name="author" content="Your Name">
  
  <!-- Include a basic link for social sharing (Open Graph) -->
  <meta property="og:title" content="CSE 340 App">
  <meta property="og:description" content="Manage vehicle inventory easily.">
  <meta property="og:image" content="/images/og-image.jpg">
  <meta property="og:url" content="http://your-website.com">
</head>
