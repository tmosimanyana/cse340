<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/vehicle-detail.css"/>
</head>
<body>
  <div class="vehicle-detail-container">
    <header class="vehicle-header">
      <h1 class="vehicle-title"><%= vehicle.year %> <%= vehicle.make %> <%= vehicle.model %></h1>
    </header>

    <div class="vehicle-main">
      <div class="vehicle-images">
        <div class="vehicle-main-image">
          <img src="<%= vehicle.image %>" alt="<%= vehicle.make %> <%= vehicle.model %> image"/>
        </div>
        <% if (vehicle.thumbnails && vehicle.thumbnails.length > 0) { %>
          <div class="vehicle-thumbnails">
            <% vehicle.thumbnails.forEach(function(thumbnail) { %>
              <img src="<%= thumbnail %>" alt="Thumbnail of <%= vehicle.make %> <%= vehicle.model %>"/>
            <% }) %>
          </div>
        <% } %>
      </div>

      <div class="vehicle-info">
        <p class="vehicle-price">No-Haggle Price: <%= formattedPrice %></p>
        <div class="vehicle-metadata">
          <p><strong>Mileage:</strong> <%= formattedMileage %></p>
          <p><strong>Color:</strong> <%= vehicle.color || 'Unknown' %></p>
          <p><strong>Fuel Type:</strong> <%= vehicle.fuel_type %></p>
          <p><strong>Drive:</strong> <%= vehicle.drive_type %></p>
          <p><strong>Transmission:</strong> <%= vehicle.transmission %></p>
          <p><strong>Stock #:</strong> <%= vehicle.stock_number %></p>
          <p><strong>VIN:</strong> <%= vehicle.vin %></p>
        </div>
        <p><strong>Description:</strong> <%= vehicle.details %></p>

        <div class="vehicle-actions">
          <button class="primary">Start My Purchase</button>
          <a href="/contact" class="secondary">Contact Us</a>
          <a href="/test-drive" class="secondary">Schedule Test Drive</a>
          <a href="/finance" class="highlight">Apply for Financing</a>
        </div>
      </div>
    </div>

    <!-- Customer Reviews Section -->
    <section class="vehicle-reviews">
      <h2>Customer Reviews</h2>

      <% if (reviews.length > 0) { %>
        <ul class="review-list">
          <% reviews.forEach(function(review) { %>
            <li class="review-item">
              <p><strong><%= review.reviewer_name %></strong> (<%= review.rating %>/5)</p>
              <p><%= review.review_text %></p>
              <p class="review-date"><%= new Date(review.created_at).toLocaleDateString() %></p>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p>No reviews yet. Be the first to leave one!</p>
      <% } %>

      <h3>Leave a Review</h3>

      <% if (errors && errors.length > 0) { %>
        <div class="review-errors">
          <ul>
            <% errors.forEach(function(error) { %>
              <li><%= error %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>

      <form action="/reviews/add" method="POST" class="review-form">
        <input type="hidden" name="vehicle_id" value="<%= vehicle.inventory_id %>">

        <label for="reviewer_name">Name</label>
        <input type="text" name="reviewer_name" id="reviewer_name" required value="<%= input.reviewer_name || '' %>">

        <label for="rating">Rating (1–5)</label>
        <input type="number" name="rating" id="rating" min="1" max="5" required value="<%= input.rating || '' %>">

        <label for="review_text">Review</label>
        <textarea name="review_text" id="review_text" rows="4" required><%= input.review_text || '' %></textarea>

        <button type="submit" class="primary">Submit Review</button>
      </form>
    </section>
  </div>
</body>
</html>
