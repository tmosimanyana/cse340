<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Welcome to CSE Motors</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <header>
      <h1>CSE Motors</h1>
    </header>

    <nav>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/inventory">Inventory</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </nav>

    <main>
      <!-- Hero Section -->
      <section class="hero">
        <img src="/images/hero.jpg" alt="Featured vehicle parked in a scenic location" />
      </section>

      <!-- Upgrades Section -->
      <section class="upgrades">
        <h2>Vehicle Upgrades</h2>
        <div class="upgrade-grid">
          <div class="upgrade">
            <img src="/images/upgrade1.jpg" alt="All-weather floor mats" />
            <p>Floor Mats</p>
          </div>
          <div class="upgrade">
            <img src="/images/upgrade2.jpg" alt="Performance exhaust system" />
            <p>Performance Exhaust</p>
          </div>
          <div class="upgrade">
            <img src="/images/upgrade3.jpg" alt="LED headlights" />
            <p>LED Headlights</p>
          </div>
          <div class="upgrade">
            <img src="/images/upgrade4.jpg" alt="Roof racks" />
            <p>Roof Rack</p>
          </div>
        </div>
      </section>

      <!-- Reviews Section -->
      <section class="reviews">
        <h2>Customer Reviews</h2>
        <ul>
          <li>"CSE Motors helped me find the perfect car!"</li>
          <li>"Amazing customer service and a great selection."</li>
          <li>"Upgrades were installed professionally. Highly recommend!"</li>
        </ul>
      </section>
    </main>

    <footer>
      <p>&copy; <%= new Date().getFullYear() %> CSE Motors. All rights reserved.</p>
    </footer>
  </body>
</html>
/* Typography and Base Layout */
body {
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  margin: 0;
  padding: 0;
  background-color: #f9fafb; /* light gray for high contrast */
  color: #111; /* almost black for great readability */
  line-height: 1.6;
}

/* Layout Components */
header, nav, footer {
  background-color: #002244; /* dark blue */
  color: #fff;
  padding: 1rem;
  text-align: center;
}

main {
  padding: 1rem;
  max-width: 960px;
  margin: auto;
}

/* Navigation Styling */
nav ul {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 1rem;
}

nav li a {
  color: #fff;
  text-decoration: none;
  padding: 0.5rem;
}

nav li a:hover,
nav li a:focus {
  background-color: #004080; /* slightly lighter blue */
  border-radius: 5px;
}

/* Headings */
h1, h2 {
  color: #002244;
  margin-bottom: 1rem;
}

/* Hero Section */
.hero img {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 10px;
}

/* Upgrades Section */
.upgrades, .reviews {
  margin-top: 2rem;
}

.upgrade-grid {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  align-items: center;
}

.upgrade {
  text-align: center;
}

.upgrade img {
  width: 100px;
  height: auto;
  border-radius: 8px;
  box-shadow: 0 2px 6px rgba(0,0,0,0.1);
}

/* Reviews Section */
.reviews ul {
  list-style: none;
  padding: 0;
  font-style: italic;
}

/* Footer */
footer {
  margin-top: 2rem;
}

footer p {
  font-size: 0.9rem;
}

/* Media Queries for Larger Screens */
@media screen and (min-width: 768px) {
  .upgrade-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-around;
  }

  .upgrade {
    flex: 0 1 200px;
  }

  main {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
}
